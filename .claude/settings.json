{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__contract-rag__.*",
        "hooks": [
          {
            "type": "command",
            "command": "yarn --silent contract-rag hook sync",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__contract-rag__.*",
        "hooks": [
          {
            "type": "command",
            "command": "yarn --silent contract-rag hook usage",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "yarn --silent contract-rag hook context",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
