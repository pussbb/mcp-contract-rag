{
  "name": "mcp-contract-rag",
  "version": "0.1.0",
  "description": "Contract-based Graph RAG MCP server: serves TS/TSX interface contracts from PostgreSQL instead of raw source",
  "type": "module",
  "private": true,
  "scripts": {
    "build:dotnet": "dotnet build src/parser/dotnet/Extractor -c Release -o src/parser/dotnet/Extractor/out --nologo -v q",
    "index": "tsx src/cli.ts index",
    "start": "tsx src/cli.ts serve",
    "typecheck": "tsc",
    "test": "tsx --test test/*.test.ts",
    "db:up": "docker compose up -d postgres",
    "usage": "tsx src/cli.ts usage",
    "contract-rag": "tsx src/cli.ts",
    "install-hooks": "tsx src/cli.ts install-hooks"
  },
  "dependencies": {
    "@babel/parser": "^8.0.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "tsconfig-paths": "^4.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/types": "^8.0.8",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
